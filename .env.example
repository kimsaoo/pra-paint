# Firebase 콘솔 > 프로젝트 설정 > 일반 > "내 앱" 섹션에서 복사
# 이 파일을 .env로 복사한 뒤 실제 값을 채워넣으세요. .env는 절대 git에 커밋하지 마세요.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gemini API (킷 화면의 "이미지로 등록" 기능용)
# https://aistudio.google.com/apikey 에서 무료로 발급
VITE_GEMINI_API_KEY=

# Tavily 검색 API (킷 정보, 크기 자동입력의 웹 검색용, 무료 월 1,000 크레딧, 카드 불필요)
# https://app.tavily.com 에서 발급. 비워두면 이전 방식(Gemini 검색 기반 조회)으로 동작
VITE_TAVILY_API_KEY=
